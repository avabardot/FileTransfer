; House of Darkness — full vertical assembly of all 13 interior/platform rooms
;
; Coordinate convention:
;   +X = east    -X = west
;   +Y = up      -Y = down
;   +Z = south   -Z = north
;
; Vertical stacking (Y):
;   Y =  0  →  Z10 Lower Domestic (entry level — top of pulley lift)
;   Y =  4  →  Z11 Mid Stack      (one floor up via Doors of Knowledge stairs)
;   Y =  8  →  Z12 Upper Private  (private rooms above mid stack)
;
; Horizontal layout mirrors the Pajama Sam source geography:
;   Entry Hall (R37) is the central hub at house level.
;   Kitchen (R38) branches west, Living Room (R39) branches east.
;   Stair Landing (R40) is north of Entry Hall — stairs ascend to Z11.
;   The weird rooms (Z11) cluster around the stair head.
;   Upper private rooms (Z12) sit above Z11 north.
;
; NOTE: These positions are designed for assembly and first-pass traversal.
;   Fine-tune doorway seam alignment in the Godot editor after loading.

[node name="HouseOfDarkness" type="Node3D"]

; ── Z10 Lower Domestic (Y = 0) ────────────────────────────────────────────────

; R36 House Exterior Lift Top — platform where the pulley basket arrives.
; Placed at the south face of the house; the front door faces north into R37.
; 6m x 6m platform, front door at local Z = -2.8 → world Z ≈ -2.8.
[node name="R36HouseExteriorLiftTop" parent="." instance=ExtResource("1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 3)

; R37 Entry Hall — first interior room, entered from R36 front door.
; R36 front door is at world Z ≈ 0.2; R37 south wall sits at Z = 0.
; 6m x 5m room extends north to Z = -5.
[node name="R37EntryHall" parent="." instance=ExtResource("2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

